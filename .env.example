# 로컬 Django 설정
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY='로컬 기본값을 바꾸려면 새 키를 입력하세요'
# EDUFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL. HOST가 비어 있으면 로컬 소켓, USER가 비어 있으면 현재 OS 계정을 사용합니다.
POSTGRES_DB=eduflow
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Celery 브로커
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# 콘솔 테스트가 기본입니다. 실제로 발송하려면 smtp.EmailBackend로 변경합니다.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP 연결 예시. 실제 발송 시 메일 제공자가 안내한 값으로 변경합니다.
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=''
DJANGO_DEFAULT_FROM_EMAIL=eduflow@example.invalid


# 운영자 신청 목록 Google Sheets 내보내기
# 문서 URL에서 /d/와 /edit 사이의 ID
GOOGLE_SHEETS_SPREADSHEET_ID=
# 서비스 계정 JSON 키 파일의 절대 경로
GOOGLE_APPLICATION_CREDENTIALS=
